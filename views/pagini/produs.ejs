<!DOCTYPE html>
<html lang="ro" data-bs-theme="dark">
    <head>
        <meta name="description" content="EduHub - pagina produs pentru culegeri si materiale educationale.">
        <meta name="keywords" content="eduhub, culegeri, produs, <%- locals.prod.nume %>">
        
        <title>EduHub - <%- locals.prod.nume %></title>
        <%- include("../fragmente/head") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    </head>
    <body>

        <%- include("../fragmente/header") %>
    <main class="page-produs">
        <section class="sectiune-produs">
            <p class="breadcrumb"><a href="/produse">Produse</a> / <span><%- locals.prod.nume %></span></p>
            <h2>Pagina produs</h2>

            <article id="art-produs">
                <!-- BONUS 9: Carousel for multiple images -->
                <div class="carousel-produs" id="carouselProdus" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <% if (locals.imagini && locals.imagini.length > 0) { %>
                            <% locals.imagini.forEach((img, idx) => { %>
                                <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                                    <img src="/resurse/imagini/produse/<%- img %>" alt="Imagine produs <%- locals.prod.nume %> - <%= idx + 1 %>" class="d-block w-100" loading="lazy" />
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="carousel-item active">
                                <img src="/resurse/imagini/produse/<%- locals.prod.imagine || 'Unknown.jpeg' %>" alt="Imagine produs <%- locals.prod.nume %>" class="d-block w-100" />
                            </div>
                        <% } %>
                    </div>

                    <% if (locals.imagini && locals.imagini.length > 1) { %>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselProdus" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterioare</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselProdus" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Urmatoare</span>
                        </button>

                        <div class="carousel-indicators">
                            <% locals.imagini.forEach((img, idx) => { %>
                                <button type="button" data-bs-target="#carouselProdus" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>" aria-label="Imagine <%= idx + 1 %>"></button>
                            <% }); %>
                        </div>
                    <% } %>
                </div>

                <div class="detalii-produs">
                    <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                    <p class="pret-linie">Pret: <span class="pret"><%- locals.prod.pret %></span> lei</p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.descriere || 'Fara descriere disponibila.' %></span></p>

                    <ul class="lista-meta">
                        <li>ID: <span class="id-produs"><%- locals.prod.id %></span></li>
                        <li>Categorie: <span class="categorie"><%- locals.prod.categorie %></span></li>
                        <li>Nivel: <span class="nivel"><%- locals.prod.nivel %></span></li>
                        <li>Numar pagini: <span class="nr_pagini"><%- locals.prod.nr_pagini %></span></li>
                        <li>Format: <span class="format"><%- locals.prod.format %></span></li>
                        <li>Acreditata minister: <span class="acreditata"><%- locals.prod.acreditata_minister ? 'da' : 'nu' %></span></li>
                        <li>Data adaugare: <span class="data_adaugare"><%- locals.prod.data_adaugare %></span></li>
                    </ul>

                    <% if (locals.prod.beneficii) { %>
                        <p>Beneficii: <span class="beneficii"><%- locals.prod.beneficii %></span></p>
                    <% } %>

                    <p class="actiuni">
                        <a class="btn-inapoi" href="/produse">Inapoi la produse</a>
                    </p>
                </div>
                </article>
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>