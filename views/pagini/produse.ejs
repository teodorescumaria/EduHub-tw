<!DOCTYPE html>
<html lang="ro" data-bs-theme="dark">
    <head>
        <meta name="description" content="EduHub - Produse educationale pentru matematica si informatica: culegeri, simulari si resurse de pregatire.">
        <meta name="keywords" content="eduhub, produse educationale, matematica, informatica, culegeri, simulari">
        <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
        <title>EduHub - Produse</title>
        <%- include("../fragmente/head") %>  
        <script type = "text/javascript" src="/resurse/js/produse.js"></script> 
        <script type = "text/javascript" src="/resurse/js/produse-cos.js"></script>
    </head>
    <body>
    <%- include("../fragmente/header") %>

    <main class="page-produse">
        <section class="hero-produse">
            <p class="eyebrow">Catalog EduHub</p>
            <h1>Produse pentru pregatire serioasa</h1>
            <p>
                Alege materiale selectate pentru matematica si informatica.
                Produsele sunt incarcate direct din baza ta de date.
            </p>
        </section>

        <%
            const preturi = locals.produse.map((p) => Number(p.pret));
            const pretMinGlobal = preturi.length ? Math.min(...preturi) : 0;
            const pretMaxGlobal = preturi.length ? Math.max(...preturi) : 0;
            const T_ZILE_PRODUS_NOU = Number(locals.intervalProdusNouZile) || 180;
            const niveluriUnice = [...new Set(locals.produse.map((p) => p.nivel))];
            const formateUnice = [...new Set(locals.produse.map((p) => p.format))];
            const beneficiiUnice = [...new Set(
                locals.produse.flatMap((p) =>
                    (p.beneficii || "")
                        .split(",")
                        .map((b) => b.trim().toLowerCase())
                        .filter(Boolean)
                )
            )];
            const paginiSortate = locals.produse.map(p => Number(p.nr_pagini)).filter(Boolean).sort((a, b) => a - b);
            const paginMin = paginiSortate[0] || 0;
            const paginMax = paginiSortate[paginiSortate.length - 1] || 999;
            const prag1 = Math.round(paginMin + (paginMax - paginMin) / 3);
            const prag2 = Math.round(paginMin + 2 * (paginMax - paginMin) / 3);
            const exempluNume = locals.produse[0]?.nome || "Ex: mate*bac";
            const exempluDescriere = (locals.produse[0]?.descriere || "").substring(0, 40).replace(/\s+\S*$/, "...") || "Ex: bacalaureat rezolvate";
            const luniRo = ["Ianuarie", "Februarie", "Martie", "Aprilie", "Mai", "Iunie", "Iulie", "August", "Septembrie", "Octombrie", "Noiembrie", "Decembrie"];
            const zileRo = ["Duminica", "Luni", "Marti", "Miercuri", "Joi", "Vineri", "Sambata"];
        %>

        <section class="panou-filtre" aria-labelledby="titlu-filtre">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h2 id="titlu-filtre" class="m-0">Filtre rapide</h2>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="switch-tema" aria-label="Schimba tema">
                    <label class="form-check-label" for="switch-tema"><i id="icon-tema" class="bi bi-moon-stars-fill"></i> <span class="d-none d-sm-inline">Tema</span></label>
                </div>
            </div>

            <div class="row g-3 align-items-start">
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="inp-nume">Nume</label>
                    <input class="form-control form-control-sm" type="text" id="inp-nume" placeholder="<%= exempluNume %>" autocomplete="off">
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="inp-pret-min">Pret minim</label>
                    <div class="range-linie">
                        <span class="range-capete"><%= Math.floor(pretMinGlobal) %></span>
                        <input class="form-range" type="range" id="inp-pret-min" value="<%= pretMinGlobal %>" min="<%= pretMinGlobal %>" max="<%= pretMaxGlobal %>" step="0.01">
                        <span class="range-capete"><%= Math.floor(pretMaxGlobal) %> <span id="infoRangeMin">(<%= Math.floor(pretMinGlobal) %>)</span></span>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="inp-pret-max">Pret maxim</label>
                    <div class="range-linie">
                        <span class="range-capete"><%= Math.floor(pretMinGlobal) %></span>
                        <input class="form-range" type="range" id="inp-pret-max" value="<%= pretMaxGlobal %>" min="<%= pretMinGlobal %>" max="<%= pretMaxGlobal %>" step="0.01">
                        <span class="range-capete"><%= Math.floor(pretMaxGlobal) %> <span id="infoRangeMax">(<%= Math.floor(pretMaxGlobal) %>)</span></span>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="inp-categorie">Categorie</label>
                    <select class="form-select form-select-sm" id="inp-categorie">
                        <option id="sel-toate" value="oricare" selected>oricare</option>
                        <% for (let opt of locals.optiuni) { %>
                            <option value="<%- opt.categorie %>"><%- opt.categorie %></option>
                        <% } %>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="inp-format">Format (datalist)</label>
                    <input class="form-control form-control-sm" id="inp-format" list="lista-formate" placeholder="Ex: fizic" autocomplete="off">
                    <datalist id="lista-formate">
                        <% for (let format of formateUnice) { %>
                            <option value="<%- format %>"></option>
                        <% } %>
                    </datalist>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label fw-semibold" for="inp-nivel">Nivel (select multiplu)</label>
                    <select class="form-select form-select-sm" id="inp-nivel" multiple size="5">
                        <option value="oricare" selected>oricare</option>
                        <% for (let nivel of niveluriUnice) { %>
                            <option value="<%- nivel %>"><%- nivel %></option>
                        <% } %>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-6">
                    <div class="form-floating">
                        <textarea class="form-control" id="inp-descriere" placeholder="<%= exempluDescriere %>" style="height: 110px;"></textarea>
                        <label for="inp-descriere">Descriere (textarea)</label>
                        <div class="invalid-feedback">Textarea contine caractere invalide.</div>
                    </div>
                </div>
            </div>

            <fieldset class="radio-grup mt-3">
                <legend class="h6 mb-2">Numar pagini</legend>
                <div class="d-flex flex-wrap gap-2">
                    <input class="btn-check" id="i_rad1" name="gr_rad" value="<%= paginMin %>:<%= prag1 %>" type="radio" autocomplete="off"/>
                    <label class="btn btn-sm btn-outline-secondary" for="i_rad1">Compacte (&lt; <%= prag1 %>)</label>

                    <input class="btn-check" id="i_rad2" name="gr_rad" value="<%= prag1 %>:<%= prag2 %>" type="radio" autocomplete="off"/>
                    <label class="btn btn-sm btn-outline-secondary" for="i_rad2">Medii (<%= prag1 %> - <%= prag2 %>)</label>

                    <input class="btn-check" id="i_rad3" name="gr_rad" value="<%= prag2 %>:<%= paginMax + 1 %>" type="radio" autocomplete="off"/>
                    <label class="btn btn-sm btn-outline-secondary" for="i_rad3">Extinse (&ge; <%= prag2 %>)</label>

                    <input class="btn-check" id="i_rad4" checked name="gr_rad" value="toate" type="radio" autocomplete="off"/>
                    <label class="btn btn-sm btn-outline-secondary" for="i_rad4">Toate</label>
                </div>
            </fieldset>

            <fieldset class="checkbox-grup mt-3">
                <legend class="h6 mb-2">Beneficii (checkbox)</legend>
                <div class="d-flex flex-wrap gap-2">
                    <% for (let beneficiu of beneficiiUnice) { %>
                        <% const idBenef = `benef_${beneficiu.replace(/\s+/g, "_").replace(/[^a-zA-Z0-9_]/g, "")}`; %>
                        <input type="checkbox" class="btn-check inp-beneficiu" id="<%- idBenef %>" value="<%- beneficiu %>" autocomplete="off">
                        <label class="btn btn-sm btn-outline-secondary" for="<%- idBenef %>"><%- beneficiu %></label>
                    <% } %>
                </div>
            </fieldset>

            <!-- BONUS 8: DOUBLE KEY SORT -->
            <fieldset class="sortare-dubla mt-3">
                <legend class="h6 mb-2">Sortare avansata (2 chei)</legend>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sort-key1">Cheie 1</label>
                        <select class="form-select form-select-sm" id="sort-key1">
                            <option value="" selected>--- Selecteaza ---</option>
                            <option value="nume">Nume</option>
                            <option value="pret">Pret</option>
                            <option value="nivel">Nivel</option>
                            <option value="data">Data adaugare</option>
                            <option value="format">Format</option>
                            <option value="pagini">Nr. pagini</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="sort-key2">Cheie 2</label>
                        <select class="form-select form-select-sm" id="sort-key2">
                            <option value="" selected>--- Selecteaza ---</option>
                            <option value="nume">Nume</option>
                            <option value="pret">Pret</option>
                            <option value="nivel">Nivel</option>
                            <option value="data">Data adaugare</option>
                            <option value="format">Format</option>
                            <option value="pagini">Nr. pagini</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-2">
                    <div>
                        <span class="fw-semibold d-block mb-2 text-sm">Direcție Cheie 1:</span>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort-dir1" id="sort-dir1-asc" value="asc" checked>
                                <label class="form-check-label" for="sort-dir1-asc">Crescător</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort-dir1" id="sort-dir1-desc" value="desc">
                                <label class="form-check-label" for="sort-dir1-desc">Descrescător</label>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span class="fw-semibold d-block mb-2 text-sm">Direcție Cheie 2:</span>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort-dir2" id="sort-dir2-asc" value="asc" checked>
                                <label class="form-check-label" for="sort-dir2-asc">Crescător</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="sort-dir2" id="sort-dir2-desc" value="desc">
                                <label class="form-check-label" for="sort-dir2-desc">Descrescător</label>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

            <div class="actiuni-filtre mt-3 d-flex flex-wrap gap-2">
                <button class="btn btn-primary btn-sm" id="filtrare"><i class="bi bi-funnel-fill"></i> <span class="d-none d-sm-inline">Filtreaza</span></button>
                <button class="btn btn-success btn-sm" id="sort-apply"><i class="bi bi-sort-down"></i> <span class="d-none d-sm-inline">Aplica sortare</span></button>
                <button class="btn btn-secondary btn-sm d-none" id="sortCrescNume"><i class="bi bi-sort-down"></i> <span class="d-none d-sm-inline">Sortare +</span></button>
                <button class="btn btn-secondary btn-sm d-none" id="sortDescrescNume"><i class="bi bi-sort-up"></i> <span class="d-none d-sm-inline">Sortare -</span></button>
                <button class="btn btn-outline-primary btn-sm" id="calculeaza"><i class="bi bi-calculator-fill"></i> <span class="d-none d-sm-inline">Calculeaza</span></button>
                <button class="btn btn-outline-secondary btn-sm" id="resetare"><i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-sm-inline">Reseteaza</span></button>
            </div>

            <p id="p-suma">Sfat: apasa Alt + C pentru suma preturilor produselor afisate.</p>
        </section>

        <section id="produse" aria-labelledby="titlu-produse">
            <h2 id="titlu-produse">Produse disponibile (<span id="numar-produse-afisate"><%- locals.produse.length %></span>)</h2>

            <% if (!locals.produse.length) { %>
                <p class="stare-goala">Nu exista produse pentru filtrul ales.</p>
            <% } %>

            <div class="grid-produse">
                <% // Determină cel mai ieftin produs din fiecare categorie
                   const minPretPeCategorie = {};
                   for (const p of locals.produse) {
                       if (!minPretPeCategorie[p.categorie] || Number(p.pret) < minPretPeCategorie[p.categorie].pret) {
                           minPretPeCategorie[p.categorie] = { pret: Number(p.pret), id: p.id };
                       }
                   }
                %>
                <% for( let prod of locals.produse) { %>
                    <%
                        const dataObj = new Date(prod.data_adaugare);
                        const zi = Number.isNaN(dataObj.getTime()) ? "-" : dataObj.getDate();
                        const luna = Number.isNaN(dataObj.getTime()) ? "-" : luniRo[dataObj.getMonth()];
                        const an = Number.isNaN(dataObj.getTime()) ? "-" : dataObj.getFullYear();
                        const ziSapt = Number.isNaN(dataObj.getTime()) ? "-" : zileRo[dataObj.getDay()];
                        const dataAfisata = `${zi}/${luna}/${an} (${ziSapt})`;
                        const esteIeftin = minPretPeCategorie[prod.categorie]?.id === prod.id;
                        // --- BONUS 18 ---
                        const msPeZi = 24*60*60*1000;
                        const azi = new Date();
                        const diffZile = (azi - dataObj) / msPeZi;
                        const esteNou = !Number.isNaN(dataObj.getTime()) && diffZile <= T_ZILE_PRODUS_NOU;
                    %>
                    <article id="art<%- prod.id %>" class="produs <%- prod.categorie %><%= esteIeftin ? ' produs-ieftin' : '' %><%= esteNou ? ' produs-nou' : '' %>" data-descriere="<%= prod.descriere || '' %>" data-beneficii="<%= prod.beneficii || '' %>" data-format="<%= prod.format || '' %>" data-pagini="<%= prod.nr_pagini %>" data-prod-id="<%- prod.id %>">
                        <div class="produs-header">
                            <h3 class="nume"><a href="/produs/<%- prod.id %>"><span class="val-nume"><%- prod.nume %></span></a></h3>
                            <% if (esteIeftin) { %>
                                <span class="badge-ieftin" title="Cel mai ieftin produs din această categorie">
                                    <i class="bi bi-star-fill"></i> Cel mai ieftin!
                                </span>
                            <% } %>
                            <% if (esteNou) { %>
                                <span class="badge-nou" title="Produs nou!">
                                    <i class="bi bi-lightning-charge-fill"></i> NOU
                                </span>
                            <% } %>
                            <div class="produs-actiuni" role="group" aria-label="Actiuni pentru produs">
                                <button class="btn-action btn-pin" type="button" data-action="pin" title="Pastreaza produsul pe ecran">
                                    <i class="bi bi-bookmark"></i>
                                </button>
                                <button class="btn-action btn-hide" type="button" data-action="hide" title="Ascunde temporar">
                                    <i class="bi bi-eye-slash"></i>
                                </button>
                                <button class="btn-action btn-delete" type="button" data-action="delete" title="Sterge din sesiune">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </div>
                        <p class="categorie-linie">Categorie: <span class="val-categorie"><%- prod.categorie %></span></p>
                        <p class="descriere-scurta"><%- prod.descriere || "Fara descriere." %></p>

                        <div class="layout-produs">
                            <figure class="media-produs">
                                <a href="/produs/<%- prod.id %>" aria-label="Deschide produsul <%- prod.nume %>">
                                    <img src="/resurse/imagini/produse/<%- prod.imagine || 'Unknown.jpeg' %>" alt="Imagine produs <%- prod.nume %>" loading="lazy" />
                                </a>
                            </figure>

                            <table class="tabel-produs">
                                <tbody>
                                    <tr>
                                        <td>Pret</td>
                                        <td><strong><span class="val-pret"><%- prod.pret %></span> lei</strong></td>
                                    </tr>
                                    <tr>
                                        <td>Nivel</td>
                                        <td><span class="val-nivel"><%- prod.nivel %></span></td>
                                    </tr>
                                    <tr>
                                        <td>Beneficii</td>
                                        <td><span class="val-beneficii"><%- prod.beneficii || "-" %></span></td>
                                    </tr>
                                    <tr>
                                        <td>Data adaugare</td>
                                        <td><time datetime="<%- prod.data_adaugare %>"><%- dataAfisata %></time></td>
                                    </tr>
                                    <tr>
                                        <td>Acreditata minister</td>
                                        <td><span class="val-acreditata"><%- prod.acreditata_minister ? "da" : "nu" %></span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <label class="selecteaza-cos">
                            <input type="checkbox" class="select-cos" value="<%- prod.id %>" autocomplete="off">
                            <span class="text-select">Selecteaza in cos</span>
                        </label>
                    </article>
                <% }%>
            </div>

            <p id="mesaj-nu-exista-produse" class="stare-goala" style="display: none;">Nu exista produse care respecta filtrele selectate.</p>
        </section>

        <!-- BONUS 11: Product Modal -->
        <div class="modal fade" id="modalProdus" tabindex="-1" aria-labelledby="modalProdusLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalProdusLabel">Detalii Produs</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Inchide"></button>
                    </div>
                    <div class="modal-body">
                        <div class="modal-produs-grid">
                            <div class="modal-produs-imagine">
                                <img id="modal-prod-imagine" src="" alt="Imagine produs" />
                            </div>
                            <div class="modal-produs-info">
                                <h3 id="modal-prod-nume"></h3>
                                <p class="modal-pret"><strong>Pret:</strong> <span id="modal-prod-pret"></span> lei</p>
                                <p><strong>Descriere:</strong> <span id="modal-prod-descriere"></span></p>
                                
                                <div class="modal-meta">
                                    <div class="meta-item">
                                        <strong>Categorie:</strong> <span id="modal-prod-categorie"></span>
                                    </div>
                                    <div class="meta-item">
                                        <strong>Nivel:</strong> <span id="modal-prod-nivel"></span>
                                    </div>
                                    <div class="meta-item">
                                        <strong>Format:</strong> <span id="modal-prod-format"></span>
                                    </div>
                                    <div class="meta-item">
                                        <strong>Nr. Pagini:</strong> <span id="modal-prod-pagini"></span>
                                    </div>
                                    <div class="meta-item">
                                        <strong>Beneficii:</strong> <span id="modal-prod-beneficii"></span>
                                    </div>
                                    <div class="meta-item">
                                        <strong>Data adaugare:</strong> <span id="modal-prod-data"></span>
                                    </div>
                                    <div class="meta-item">
                                        <strong>Acreditata minister:</strong> <span id="modal-prod-acreditata"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a id="modal-link-produs" href="" class="btn btn-primary" target="_blank">Vizita pagina produs</a>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Inchide</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>